generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum SpeciesCategory {
  FOREST
  SEA
  PLANT
  MYTHIC
}

enum Rarity {
  B
  A
  S
  SS
  SSR
}

enum ShopCategory {
  EGG
  JAR_SKIN
  MUSIC
  BOOST
}

/// Vật phẩm bổ trợ (ShopCategory.BOOST) — FOCUS_MINUTES cộng thẳng Giờ tích luỹ, HATCH_MINUTES
/// cộng thẳng phút ấp cho 1 trứng do người chơi chọn khi "Dùng" (xem ShopService.useItem).
enum BoostType {
  FOCUS_MINUTES
  HATCH_MINUTES
}

enum SessionStatus {
  RUNNING
  COMPLETED
  GIVEN_UP
}

/// Nhãn tuỳ chọn gắn cho 1 phiên tập trung (VD "Học tập") — bộ cố định, không cho user tự đặt tên
/// (giữ đơn giản, khớp độ phức tạp hiện có của Settings — mọi setting khác đều là giá trị cố định,
/// không có màn "quản lý danh sách tự tạo" nào trong app).
enum SessionLabel {
  STUDY
  WORK
  READING
  CREATIVE
  OTHER
}

enum LedgerReason {
  SESSION_REWARD
  PURCHASE
  REFUND
  ADMIN_ADJUST
  MARKET_BUY
  MARKET_SELL
  ITEM_USE
  STREAK_REWARD
}

/// Xu Lá (COIN) và Giờ tích luỹ (FOCUS_MINUTE, lưu bằng phút) — 2 loại tiền tệ độc lập,
/// cùng dùng chung bảng ledger (LedgerEntry) để tái dùng logic earn/spend/balance.
enum CurrencyType {
  COIN
  FOCUS_MINUTE
}

enum OwnedEggStatus {
  INCUBATING
  HATCHED
}

/// Chợ (T-106) — người chơi bán bản sao dư/trứng đang ấp, Admin bán vật phẩm siêu hiếm.
enum MarketItemType {
  SPECIES
  EGG
}

enum MarketListingSellerType {
  USER
  ADMIN
}

/// PENDING_APPROVAL chỉ áp dụng cho tin SPECIES rarity SSR hoặc category MYTHIC do USER đăng —
/// Admin duyệt (ACTIVE) hoặc từ chối (REJECTED) qua AdminJS trước khi hiện công khai.
enum MarketListingStatus {
  PENDING_APPROVAL
  ACTIVE
  SOLD
  CANCELLED
  REJECTED
}

/// "Phát quà" (T-120) chỉ tặng được 1 trong 2 loại vật phẩm — giống `MarketItemType` nhưng tách
/// enum riêng vì đây là khái niệm nghiệp vụ khác (audit log tặng quà, không phải Chợ).
enum GiftItemKind {
  SPECIES
  EGG
  SHOP_ITEM
}

/// Loại thư trong Hộp thư (T-123) — mỗi loại có `payload` JSON khác nhau (xem InboxService).
enum InboxMessageType {
  EGG_RECEIVED
  EGG_HATCHED
  ADMIN_GIFT
  STREAK_REWARD
  /// T-128 — nhắc streak sắp mất (chưa tập trung hôm nay dù còn streak tới hôm qua).
  STREAK_REMINDER
  /// T-128 — vật phẩm/loài/trứng đăng bán ở Chợ vừa được người khác mua.
  MARKET_SOLD
}

/// Loại quà trong cấu hình streak (StreakRewardDay.rewards) — id null khi kind=COIN (quantity =
/// số Xu Lá tặng thẳng thay vì số lượng vật phẩm). Xem StreaksService.checkAndGrant.
enum StreakRewardItemKind {
  SPECIES
  EGG_TYPE
  SHOP_ITEM
  COIN
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  displayName  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  settings         UserSettings?
  sessions         Session[]
  ledger           LedgerEntry[]
  collection       CollectionEntry[]
  inventory        InventoryItem[]
  ownedEggs        OwnedEgg[]
  giftLogsReceived GiftLog[]
  inboxMessages    InboxMessage[]
  streakClaims     StreakClaim[]

  marketListingsSold   MarketListing[] @relation("MarketListingsSold")
  marketListingsBought MarketListing[] @relation("MarketListingsBought")

  @@map("users")
}

/// `userId` từng là @id (khoá chính = khoá ngoại) — @adminjs/prisma đánh dấu field vừa là FK vừa
/// PK là `isReadOnly` trong DMMF và LOẠI HẲN nó khỏi danh sách property, khiến `BaseRecord.id()`
/// không tìm được property nào `isId()` → "does not have an id property" (500 ở list AdminJS).
/// Sửa bằng cách tách khoá chính thật (`id`) ra khỏi khoá ngoại (`userId`, giữ `@unique` để
/// `where: { userId }` ở SettingsService vẫn hoạt động y nguyên).
model UserSettings {
  id                String  @id @default(uuid())
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String  @unique
  focusMinutes      Int     @default(25)
  breakMinutes      Int     @default(5)
  strictModeEnabled Boolean @default(true)
  soundTheme        String  @default("default")
  /// Tắt hoàn toàn âm thanh (nhạc nền + tiếng "ting" hoàn thành) — độc lập với soundTheme, không
  /// xoá lựa chọn chủ đề khi bật lại.
  soundMuted        Boolean @default(false)

  @@map("user_settings")
}

model Species {
  id         String          @id @default(uuid())
  name       String
  category   SpeciesCategory
  archetype  String
  paletteIdx Int
  rarity     Rarity
  lore       String?
  isActive   Boolean         @default(true)

  eggDrops        EggDropEntry[]
  collectionRows  CollectionEntry[]
  ownedEggResults OwnedEgg[]
  marketListings  MarketListing[]

  @@map("species")
}

model EggType {
  id               String @id @default(uuid())
  name             String
  colorHex         String
  priceCoin        Int    @default(0)
  /// Giá quy đổi bằng Giờ tích luỹ (đơn vị: phút) — người chơi trả bằng Xu Lá HOẶC Giờ tích luỹ.
  priceHours       Int    @default(0)
  /// Thời gian ấp cần thiết (phút) để trứng loại này nở — mỗi loại khác nhau, admin cấu hình.
  hatchDurationMin Int    @default(60)

  drops         EggDropEntry[]
  rarityWeights EggRarityWeight[]
  shopItems     ShopItem[]
  ownedEggs     OwnedEgg[]

  @@map("egg_types")
}

/// 1 quả trứng cụ thể người chơi sở hữu (mua ở Shop) — có tiến độ ấp riêng, tích luỹ qua
/// nhiều phiên tập trung cho tới khi đủ EggType.hatchDurationMin thì nở ra 1 Species.
model OwnedEgg {
  id              String         @id @default(uuid())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  eggType         EggType        @relation(fields: [eggTypeId], references: [id])
  eggTypeId       String
  status          OwnedEggStatus @default(INCUBATING)
  incubatedMin    Int            @default(0)
  acquiredAt      DateTime       @default(now())
  hatchedAt       DateTime?
  resultSpecies   Species?       @relation(fields: [resultSpeciesId], references: [id])
  resultSpeciesId String?

  sessions       Session[]
  marketListings MarketListing[]

  @@index([userId, status])
  @@map("owned_eggs")
}

/// Cấu hình toàn cục do admin quản lý — 1 dòng duy nhất (id cố định = 1).
model GameSettings {
  id                       Int   @id @default(1)
  /// Số Xu Lá nhận được cho mỗi phút tập trung hoàn thành (khi người dùng chọn nhận Xu Lá) —
  /// khớp tỉ giá quy đổi 1 phút Giờ tích luỹ = 10 Xu Lá dùng trong Cửa hàng.
  coinsPerFocusMinute      Float @default(10)
  /// % phí giao dịch Chợ (T-106) — trừ vào phần người bán nhận được, không hoàn ai (currency sink).
  marketFeePercent         Float @default(10)
  /// Số tin đăng bán ACTIVE tối đa/user cùng lúc trên Chợ (T-106) — chống spam thị trường.
  maxActiveListingsPerUser Int   @default(10)

  @@map("game_settings")
}

model EggDropEntry {
  id        String  @id @default(uuid())
  eggType   EggType @relation(fields: [eggTypeId], references: [id], onDelete: Cascade)
  eggTypeId String
  species   Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  speciesId String
  weight    Int     @default(1)

  @@unique([eggTypeId, speciesId])
  @@map("egg_drop_table")
}

/// Trọng số cấp bậc RIÊNG theo từng loại trứng (T-116) — thay cho bảng `rarity_weights` toàn cục
/// cũ (1 trọng số dùng chung mọi trứng). Mỗi loại trứng có 1 "đường cong" tỉ lệ khác nhau (VD
/// trứng thường chỉ rơi B/A/S, trứng Bí Ẩn rơi A→SSR, trứng Truyền thuyết rơi S→SSR) — admin sửa
/// trực tiếp từng dòng qua AdminJS. Vắng mặt (không có dòng nào) = cấp đó không bao giờ rơi ở
/// trứng này, xem `eggs.service.ts#loadWeightedDrops`.
/// `@@id([eggTypeId, rarity])` (khoá chính GHÉP) từng khiến DMMF không field nào có `isId: true`
/// (Prisma chỉ đánh dấu field riêng lẻ `isId` cho PK đơn) — cộng thêm `eggTypeId` cũng bị đánh
/// dấu `isReadOnly` (vì vừa là FK) nên bị @adminjs/prisma loại khỏi property list luôn, y hệt lỗi
/// ở UserSettings phía trên. Sửa bằng cách tách khoá chính thật (`id`) ra, giữ ràng buộc "1 dòng
/// trọng số/eggType/rarity" bằng `@@unique` thay vì `@@id`.
model EggRarityWeight {
  id        String  @id @default(uuid())
  eggType   EggType @relation(fields: [eggTypeId], references: [id], onDelete: Cascade)
  eggTypeId String
  rarity    Rarity
  weight    Int

  @@unique([eggTypeId, rarity])
  @@map("egg_rarity_weights")
}

model ShopItem {
  id          String       @id @default(uuid())
  name        String
  description String?
  category    ShopCategory
  priceCoin   Int
  isActive    Boolean      @default(true)
  /// T-116 — false = hiện trong Cửa hàng nhưng KHÔNG bán được (không hiện giá, nút mua bị khoá) —
  /// dùng cho trứng Truyền thuyết mà Admin phát trực tiếp qua `OwnedEgg` (đã là resource AdminJS
  /// sẵn có), không phải mua bằng Xu Lá/Giờ tích luỹ.
  purchasable Boolean      @default(true)
  eggType     EggType?     @relation(fields: [eggTypeId], references: [id])
  eggTypeId   String?
  /// Chỉ có ý nghĩa khi category = BOOST — loại hiệu ứng khi "Dùng" (xem ShopService.useItem).
  boostType   BoostType?
  /// Số phút cộng thêm khi dùng (Giờ tích luỹ nếu FOCUS_MINUTES, phút ấp nếu HATCH_MINUTES).
  boostAmount Int?

  inventory InventoryItem[]

  @@map("shop_items")
}

model InventoryItem {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  shopItem   ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)
  shopItemId String
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now())
  equipped   Boolean  @default(false)

  @@unique([userId, shopItemId])
  @@map("user_inventory")
}

model Session {
  id                 String        @id @default(uuid())
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  /// Trứng đang ấp trong phiên này — không bắt buộc, có thể tập trung mà không ấp trứng nào.
  ownedEgg           OwnedEgg?     @relation(fields: [ownedEggId], references: [id])
  ownedEggId         String?
  /// Tỉ lệ % thời gian dành cho ấp trứng (phần còn lại quy đổi theo rewardCurrency) — chỉ có ý nghĩa khi có ownedEggId.
  incubationRatio    Float?
  /// Phần thời gian KHÔNG dành cho ấp trứng chỉ quy đổi thành 1 loại tiền duy nhất — người dùng
  /// chọn trước khi bắt đầu phiên. Không còn nhận cả 2 loại cùng lúc như thiết kế trước đó.
  rewardCurrency     CurrencyType  @default(COIN)
  plannedMin         Int
  strictMode         Boolean       @default(true)
  /// Nhãn tuỳ chọn (VD "Học tập") — không bắt buộc, null = chưa gắn nhãn. Dùng để gom thống kê
  /// theo nhãn ở GET stats/by-label (chỉ tính phiên COMPLETED, xem StatsService.getByLabel).
  label              SessionLabel?
  status             SessionStatus @default(RUNNING)
  startedAt          DateTime      @default(now())
  endedAt            DateTime?
  coinsEarned        Int?
  /// Số phút thực nhận vào Giờ tích luỹ sau khi hoàn thành (đã trừ phần dành cho ấp trứng, nếu có).
  minutesAccumulated Int?
  /// Số phút thực đưa vào ấp trứng (0 nếu không chọn trứng).
  minutesIncubated   Int?
  clientEventId      String?       @unique

  @@index([userId, startedAt])
  @@map("sessions")
}

model LedgerEntry {
  id                 String       @id @default(uuid())
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  amount             Int
  currency           CurrencyType @default(COIN)
  reason             LedgerReason
  refSessionId       String?
  refShopItemId      String?
  refMarketListingId String?
  clientEventId      String?      @unique
  createdAt          DateTime     @default(now())

  @@index([userId, currency, createdAt])
  @@map("currency_ledger")
}

model CollectionEntry {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  species        Species  @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  speciesId      String
  hatchCount     Int      @default(0)
  /// Số bản đang thực sự sở hữu NGAY BÂY GIỜ (T-106) — khác hatchCount (lịch sử, không giảm khi
  /// bán). Tăng khi nở HOẶC mua ở Chợ, giảm khi bán, có thể về 0 (không xoá CollectionEntry —
  /// loài vẫn hiện đã mở khoá, chỉ không còn "đứng" trong Khu vườn nữa, xem Nhóm G).
  ownedCount     Int      @default(0)
  isFavorite     Boolean  @default(false)
  firstHatchedAt DateTime @default(now())
  lastHatchedAt  DateTime @default(now())

  @@unique([userId, speciesId])
  @@map("user_collection")
}

/// Chợ (T-106, docs/wireframes/market-feature.html) — user bán bản sao dư loài/thực vật/trứng,
/// Admin bán vật phẩm siêu hiếm. `itemType` quyết định speciesId hay ownedEggId có giá trị.
model MarketListing {
  id            String                  @id @default(uuid())
  itemType      MarketItemType
  sellerType    MarketListingSellerType @default(USER)
  seller        User?                   @relation("MarketListingsSold", fields: [sellerId], references: [id])
  sellerId      String?
  species       Species?                @relation(fields: [speciesId], references: [id])
  speciesId     String?
  ownedEgg      OwnedEgg?               @relation(fields: [ownedEggId], references: [id])
  ownedEggId    String?
  priceCoin     Int
  status        MarketListingStatus     @default(ACTIVE)
  buyer         User?                   @relation("MarketListingsBought", fields: [buyerId], references: [id])
  buyerId       String?
  clientEventId String?                 @unique
  createdAt     DateTime                @default(now())
  soldAt        DateTime?
  cancelledAt   DateTime?

  @@index([status, itemType])
  @@index([sellerId, status])
  @@map("market_listings")
}

/// Nhật ký "Phát quà" (T-120) — trước đây submit xong không lưu vết gì; model này vừa thêm audit
/// trail (ai tặng ai, tặng gì, bao nhiêu, lúc nào) vừa là resource AdminJS thật để "Phát quà" nằm
/// chung nhóm điều hướng "Người dùng" với OwnedEgg/InventoryItem thay vì trang rời ở mục "Trang"
/// (yêu cầu Dev1002 2026-07-27). `itemId` trỏ tới Species hoặc EggType tuỳ `itemKind` — không đặt
/// quan hệ FK thật vì 1 cột không thể tham chiếu 2 bảng khác nhau, `itemName` là snapshot tên lúc
/// tặng để admin đọc lịch sử không cần join.
model GiftLog {
  id          String       @id @default(uuid())
  recipient   User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  itemKind    GiftItemKind
  itemId      String
  itemName    String
  quantity    Int
  createdAt   DateTime     @default(now())

  @@index([recipientId])
  @@map("gift_logs")
}

/// Cấu hình Force Update (T-121) — singleton (id cố định = 1), Admin chỉnh qua AdminJS mỗi lần
/// release app cần ép người dùng cập nhật. `GET /app-version` không cần JWT (gọi được ngay ở
/// Splash trước khi có token) — xem `app-version.service.ts`.
model AppVersionConfig {
  id                      Int    @id @default(1)
  latestVersionCode       Int    @default(1)
  minSupportedVersionCode Int    @default(1)
  updateUrl               String @default("https://play.google.com/store/apps/details?id=com.cozypomo.app")
  updateTitle             String @default("Cần cập nhật phiên bản mới")
  updateMessage           String @default("Phiên bản bạn đang dùng đã quá cũ, vui lòng cập nhật để tiếp tục sử dụng CozyPomo.")

  @@map("app_version_config")
}

/// Hộp thư (T-123) — thông báo trong app khi nhận trứng/trứng nở/admin tặng quà. `payload` lưu
/// speciesId/eggTypeId/rarity/quantity tuỳ `type`, để app vẽ đúng icon mà không cần gọi thêm API.
model InboxMessage {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      InboxMessageType
  title     String
  body      String
  payload   Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("inbox_messages")
}

/// Cấu hình quà thưởng streak ngày liên tục — 7 dòng cố định (day 1..7), seed sẵn rewards rỗng,
/// admin điền qua AdminJS (StreakRewardEditPage.tsx). `rewards` là snapshot JSON dạng
/// `[{ kind: StreakRewardItemKind, id?: string, name: string, quantity: number }]` — không đặt
/// quan hệ FK thật vì 1 phần tử có thể trỏ Species/EggType/ShopItem tuỳ `kind` (giống GiftLog).
model StreakRewardDay {
  day       Int      @id
  rewards   Json?
  updatedAt DateTime @updatedAt

  @@map("streak_reward_days")
}

/// 1 dòng/user/ngày — đánh dấu đã tính streak cho ngày đó, chặn StreaksService.checkAndGrant
/// phát quà trùng nếu user hoàn thành nhiều phiên cùng 1 ngày (idempotent theo `claimedOn`).
model StreakClaim {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// yyyy-mm-dd (UTC) — ngày tính streak.
  claimedOn String
  /// Độ dài streak tại thời điểm tính (đã cap tối đa 7) — chỉ để audit/debug.
  streakDay Int
  createdAt DateTime @default(now())

  @@unique([userId, claimedOn])
  @@map("streak_claims")
}
