generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum SpeciesCategory {
  FOREST
  SEA
  PLANT
  MYTHIC
}

enum Rarity {
  B
  A
  S
  SS
  SSR
}

enum ShopCategory {
  EGG
  JAR_SKIN
  MUSIC
}

enum SessionStatus {
  RUNNING
  COMPLETED
  GIVEN_UP
}

enum LedgerReason {
  SESSION_REWARD
  PURCHASE
  REFUND
  ADMIN_ADJUST
  MARKET_BUY
  MARKET_SELL
}

/// Xu Lá (COIN) và Giờ tích luỹ (FOCUS_MINUTE, lưu bằng phút) — 2 loại tiền tệ độc lập,
/// cùng dùng chung bảng ledger (LedgerEntry) để tái dùng logic earn/spend/balance.
enum CurrencyType {
  COIN
  FOCUS_MINUTE
}

enum OwnedEggStatus {
  INCUBATING
  HATCHED
}

/// Chợ (T-106) — người chơi bán bản sao dư/trứng đang ấp, Admin bán vật phẩm siêu hiếm.
enum MarketItemType {
  SPECIES
  EGG
}

enum MarketListingSellerType {
  USER
  ADMIN
}

/// PENDING_APPROVAL chỉ áp dụng cho tin SPECIES rarity SSR hoặc category MYTHIC do USER đăng —
/// Admin duyệt (ACTIVE) hoặc từ chối (REJECTED) qua AdminJS trước khi hiện công khai.
enum MarketListingStatus {
  PENDING_APPROVAL
  ACTIVE
  SOLD
  CANCELLED
  REJECTED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  displayName  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  settings   UserSettings?
  sessions   Session[]
  ledger     LedgerEntry[]
  collection CollectionEntry[]
  inventory  InventoryItem[]
  ownedEggs  OwnedEgg[]

  marketListingsSold   MarketListing[] @relation("MarketListingsSold")
  marketListingsBought MarketListing[] @relation("MarketListingsBought")

  @@map("users")
}

model UserSettings {
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String  @id
  focusMinutes      Int     @default(25)
  breakMinutes      Int     @default(5)
  strictModeEnabled Boolean @default(true)
  soundTheme        String  @default("default")

  @@map("user_settings")
}

model Species {
  id         String          @id @default(uuid())
  name       String
  category   SpeciesCategory
  archetype  String
  paletteIdx Int
  rarity     Rarity
  lore       String?
  isActive   Boolean         @default(true)

  eggDrops        EggDropEntry[]
  collectionRows  CollectionEntry[]
  ownedEggResults OwnedEgg[]
  marketListings  MarketListing[]

  @@map("species")
}

model EggType {
  id               String @id @default(uuid())
  name             String
  colorHex         String
  priceCoin        Int    @default(0)
  /// Giá quy đổi bằng Giờ tích luỹ (đơn vị: phút) — người chơi trả bằng Xu Lá HOẶC Giờ tích luỹ.
  priceHours       Int    @default(0)
  /// Thời gian ấp cần thiết (phút) để trứng loại này nở — mỗi loại khác nhau, admin cấu hình.
  hatchDurationMin Int    @default(60)

  drops        EggDropEntry[]
  rarityWeights EggRarityWeight[]
  shopItems    ShopItem[]
  ownedEggs    OwnedEgg[]

  @@map("egg_types")
}

/// 1 quả trứng cụ thể người chơi sở hữu (mua ở Shop) — có tiến độ ấp riêng, tích luỹ qua
/// nhiều phiên tập trung cho tới khi đủ EggType.hatchDurationMin thì nở ra 1 Species.
model OwnedEgg {
  id              String         @id @default(uuid())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  eggType         EggType        @relation(fields: [eggTypeId], references: [id])
  eggTypeId       String
  status          OwnedEggStatus @default(INCUBATING)
  incubatedMin    Int            @default(0)
  acquiredAt      DateTime       @default(now())
  hatchedAt       DateTime?
  resultSpecies   Species?       @relation(fields: [resultSpeciesId], references: [id])
  resultSpeciesId String?

  sessions       Session[]
  marketListings MarketListing[]

  @@index([userId, status])
  @@map("owned_eggs")
}

/// Cấu hình toàn cục do admin quản lý — 1 dòng duy nhất (id cố định = 1).
model GameSettings {
  id                  Int   @id @default(1)
  /// Số Xu Lá nhận được cho mỗi phút tập trung hoàn thành (khi người dùng chọn nhận Xu Lá) —
  /// khớp tỉ giá quy đổi 1 phút Giờ tích luỹ = 10 Xu Lá dùng trong Cửa hàng.
  coinsPerFocusMinute Float @default(10)
  /// % phí giao dịch Chợ (T-106) — trừ vào phần người bán nhận được, không hoàn ai (currency sink).
  marketFeePercent Float @default(10)
  /// Số tin đăng bán ACTIVE tối đa/user cùng lúc trên Chợ (T-106) — chống spam thị trường.
  maxActiveListingsPerUser Int @default(10)

  @@map("game_settings")
}

model EggDropEntry {
  id        String  @id @default(uuid())
  eggType   EggType @relation(fields: [eggTypeId], references: [id], onDelete: Cascade)
  eggTypeId String
  species   Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  speciesId String
  weight    Int     @default(1)

  @@unique([eggTypeId, speciesId])
  @@map("egg_drop_table")
}

/// Trọng số cấp bậc RIÊNG theo từng loại trứng (T-116) — thay cho bảng `rarity_weights` toàn cục
/// cũ (1 trọng số dùng chung mọi trứng). Mỗi loại trứng có 1 "đường cong" tỉ lệ khác nhau (VD
/// trứng thường chỉ rơi B/A/S, trứng Bí Ẩn rơi A→SSR, trứng Truyền thuyết rơi S→SSR) — admin sửa
/// trực tiếp từng dòng qua AdminJS. Vắng mặt (không có dòng nào) = cấp đó không bao giờ rơi ở
/// trứng này, xem `eggs.service.ts#loadWeightedDrops`.
model EggRarityWeight {
  eggType   EggType @relation(fields: [eggTypeId], references: [id], onDelete: Cascade)
  eggTypeId String
  rarity    Rarity
  weight    Int

  @@id([eggTypeId, rarity])
  @@map("egg_rarity_weights")
}

model ShopItem {
  id          String       @id @default(uuid())
  name        String
  description String?
  category    ShopCategory
  priceCoin   Int
  isActive    Boolean      @default(true)
  /// T-116 — false = hiện trong Cửa hàng nhưng KHÔNG bán được (không hiện giá, nút mua bị khoá) —
  /// dùng cho trứng Truyền thuyết mà Admin phát trực tiếp qua `OwnedEgg` (đã là resource AdminJS
  /// sẵn có), không phải mua bằng Xu Lá/Giờ tích luỹ.
  purchasable Boolean      @default(true)
  eggType     EggType?     @relation(fields: [eggTypeId], references: [id])
  eggTypeId   String?

  inventory InventoryItem[]

  @@map("shop_items")
}

model InventoryItem {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  shopItem   ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)
  shopItemId String
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now())
  equipped   Boolean  @default(false)

  @@unique([userId, shopItemId])
  @@map("user_inventory")
}

model Session {
  id                 String        @id @default(uuid())
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  /// Trứng đang ấp trong phiên này — không bắt buộc, có thể tập trung mà không ấp trứng nào.
  ownedEgg           OwnedEgg?     @relation(fields: [ownedEggId], references: [id])
  ownedEggId         String?
  /// Tỉ lệ % thời gian dành cho ấp trứng (phần còn lại quy đổi theo rewardCurrency) — chỉ có ý nghĩa khi có ownedEggId.
  incubationRatio    Float?
  /// Phần thời gian KHÔNG dành cho ấp trứng chỉ quy đổi thành 1 loại tiền duy nhất — người dùng
  /// chọn trước khi bắt đầu phiên. Không còn nhận cả 2 loại cùng lúc như thiết kế trước đó.
  rewardCurrency     CurrencyType  @default(COIN)
  plannedMin         Int
  strictMode         Boolean       @default(true)
  status             SessionStatus @default(RUNNING)
  startedAt          DateTime      @default(now())
  endedAt            DateTime?
  coinsEarned        Int?
  /// Số phút thực nhận vào Giờ tích luỹ sau khi hoàn thành (đã trừ phần dành cho ấp trứng, nếu có).
  minutesAccumulated Int?
  /// Số phút thực đưa vào ấp trứng (0 nếu không chọn trứng).
  minutesIncubated   Int?
  clientEventId      String?       @unique

  @@index([userId, startedAt])
  @@map("sessions")
}

model LedgerEntry {
  id            String       @id @default(uuid())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  amount        Int
  currency      CurrencyType @default(COIN)
  reason        LedgerReason
  refSessionId  String?
  refShopItemId String?
  refMarketListingId String?
  clientEventId String?      @unique
  createdAt     DateTime     @default(now())

  @@index([userId, currency, createdAt])
  @@map("currency_ledger")
}

model CollectionEntry {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  species        Species  @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  speciesId      String
  hatchCount     Int      @default(0)
  /// Số bản đang thực sự sở hữu NGAY BÂY GIỜ (T-106) — khác hatchCount (lịch sử, không giảm khi
  /// bán). Tăng khi nở HOẶC mua ở Chợ, giảm khi bán, có thể về 0 (không xoá CollectionEntry —
  /// loài vẫn hiện đã mở khoá, chỉ không còn "đứng" trong Khu vườn nữa, xem Nhóm G).
  ownedCount     Int      @default(0)
  isFavorite     Boolean  @default(false)
  firstHatchedAt DateTime @default(now())
  lastHatchedAt  DateTime @default(now())

  @@unique([userId, speciesId])
  @@map("user_collection")
}

/// Chợ (T-106, docs/wireframes/market-feature.html) — user bán bản sao dư loài/thực vật/trứng,
/// Admin bán vật phẩm siêu hiếm. `itemType` quyết định speciesId hay ownedEggId có giá trị.
model MarketListing {
  id         String                  @id @default(uuid())
  itemType   MarketItemType
  sellerType MarketListingSellerType @default(USER)
  seller     User?                   @relation("MarketListingsSold", fields: [sellerId], references: [id])
  sellerId   String?
  species    Species?                @relation(fields: [speciesId], references: [id])
  speciesId  String?
  ownedEgg   OwnedEgg?               @relation(fields: [ownedEggId], references: [id])
  ownedEggId String?
  priceCoin  Int
  status     MarketListingStatus    @default(ACTIVE)
  buyer      User?                   @relation("MarketListingsBought", fields: [buyerId], references: [id])
  buyerId    String?
  clientEventId String?              @unique
  createdAt  DateTime                @default(now())
  soldAt     DateTime?
  cancelledAt DateTime?

  @@index([status, itemType])
  @@index([sellerId, status])
  @@map("market_listings")
}
